# Coach service settings. Put real values in your shell or a .env.local you never commit.
OPENAI_API_KEY=
# Chess truth API: the analysis-schema mock until Person 1's service is ready.
CHESS_API_URL=http://localhost:8064
# "openai" (needs OPENAI_API_KEY), "scripted" (no LLM, for development) or "auto" (openai if a key is set).
COACH_LLM=auto
# Model per tier. Simple questions use the fast tier, complex ones the deep tier.
COACH_MODEL_FAST=gpt-6.1-sol
COACH_MODEL_DEEP=gpt-6.1-sol
COACH_EFFORT_FAST=low
COACH_EFFORT_DEEP=high
COACH_PORT=8065
COACH_CORS_ORIGINS=http://localhost:5173
