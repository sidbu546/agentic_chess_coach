            "color": "white"
          },
          "pinner": {
            "square": "b4",
            "type": "bishop",
            "color": "black"
          },
          "shielded": {
            "square": "e1",
            "type": "king",
            "color": "white"
          },
          "absolute": true,
          "ray": [
            "b4",
            "c3",
            "d2",
            "e1"
          ]
        }
      ]
    }
  }
